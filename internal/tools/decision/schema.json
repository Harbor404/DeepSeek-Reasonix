{
  "type":"object","additionalProperties":false,
  "required":["as_of","options","constraints","preferences","evidence"],
  "properties":{
    "as_of":{"type":"string","format":"date-time","description":"Reference time for this conditional comparison; future observations and expired evidence are unusable"},
    "options":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/option"}},
    "constraints":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/constraint"}},
    "preferences":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/preference"}},
    "evidence":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/evidence"}}
  },
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":128},
    "metric":{"type":"string","minLength":1,"maxLength":64},
    "unit":{"type":"string","minLength":1,"maxLength":32},
    "number":{"type":"string","maxLength":64,"pattern":"^[+-]?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]{1,3})?$","description":"Finite decimal string; at most 64 characters and a three-digit exponent"},
    "refs":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "option":{"type":"object","additionalProperties":false,"required":["id","name","metrics"],"properties":{
      "id":{"$ref":"#/$defs/id"},"name":{"type":"string","minLength":1,"maxLength":256},
      "metrics":{"type":"object","minProperties":1,"maxProperties":16,"additionalProperties":{"$ref":"#/$defs/refs"}}
    }},
    "constraint":{"type":"object","additionalProperties":false,"required":["id","metric","op","limit","unit","evidence_ids"],"properties":{
      "id":{"$ref":"#/$defs/id"},"metric":{"$ref":"#/$defs/metric"},"op":{"type":"string","enum":["lte","gte","eq"]},
      "limit":{"$ref":"#/$defs/number"},"unit":{"$ref":"#/$defs/unit"},"evidence_ids":{"$ref":"#/$defs/refs","description":"Sources for the user-declared limit, with the same metric, numeric value and unit; never invent a user constraint"}
    }},
    "preference":{"type":"object","additionalProperties":false,"required":["metric","unit","direction"],"properties":{
      "metric":{"$ref":"#/$defs/metric"},"unit":{"$ref":"#/$defs/unit"},"direction":{"type":"string","enum":["min","max"]}
    }},
    "evidence":{"type":"object","additionalProperties":false,"required":["id","key","text","source","observed_at","fact"],"properties":{
      "id":{"$ref":"#/$defs/id"},"key":{"$ref":"#/$defs/id","description":"Stable subject-and-metric identity across revisions, e.g. plan_a.monthly_cost; different options must use different keys"},"text":{"type":"string","minLength":1,"maxLength":1024},
      "source":{"type":"object","additionalProperties":false,"required":["uri","version"],"properties":{"uri":{"type":"string","minLength":1,"maxLength":512},"version":{"$ref":"#/$defs/id"}}},
      "observed_at":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},
      "supersedes":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
      "fact":{"type":"object","additionalProperties":false,"required":["metric","value","unit"],"properties":{"metric":{"$ref":"#/$defs/metric"},"value":{"$ref":"#/$defs/number"},"unit":{"$ref":"#/$defs/unit"}}}
    }}
  }
}
